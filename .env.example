# The Space link the inspector embeds. The default is the public webmcpinspector.com Space.
VITE_SPACE_URL=

# The same Space's widget key and ID, used by the extension inside the page.
VITE_WIDGET_KEY=
VITE_SPACE_ID=

# Automation key (ak_…) of that Space, for the "Connect your agent" links. It is public to anyone
# who opens the inspector, so use a Space made for this. Leave empty and visitors paste their own.
VITE_AUTOMATION_KEY=

# Only needed when the Session MCP Server is not at https://session-mcp.<session host>/mcp.
VITE_MCP_URL=
